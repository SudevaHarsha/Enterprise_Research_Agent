# ─────────────────────────────────────────────────────────────
# ECRKE environment template
# Copy to .env and fill in values. NEVER commit the real .env.
# Secrets are referenced by NAME only - never paste values here
# or into any file in this repository.
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# Database (relational provenance core)
POSTGRES_DB=ecrke
POSTGRES_USER=ecrke
POSTGRES_PASSWORD=ecrke_dev
# Host port 5433 (5432 may be taken by other local stacks; internal port is 5432)
DATABASE_URL=postgresql+asyncpg://ecrke:ecrke_dev@localhost:5433/ecrke
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://ecrke:ecrke_dev@localhost:5433/ecrke_prefect
PREFECT_API_URL=http://localhost:4200/api

# LLM providers (LiteLLM gateway) - set the ones you use
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GOOGLE_API_KEY=
LLM_MODEL_CHEAP=gemini/gemini-2.0-flash
LLM_MODEL_STRONG=gemini/gemini-2.0-pro

# Search / retrieval
SEARCH_API_PROVIDER=
SEARCH_API_KEY=
ALLOWED_DOMAINS=

# Blob storage (S3-compatible, e.g. Cloudflare R2) for raw documents
BLOB_ENDPOINT=
BLOB_BUCKET=
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=

# Run governance
RUN_BUDGET_USD=2.0
CIRCUIT_BREAKER_MAX_STAGE_FAILURES=3

# Guardrails — NON-NEGOTIABLE (G-13). These flags are immutable: any attempt
# to disable one (false / 0 / off / no) is rejected by the config schema with
# a ValidationError. Guardrails cannot be turned off via configuration.
GUARDRAIL_EGRESS_ALLOWLIST_ENABLED=true
GUARDRAIL_VERIFY_FIRST_ENABLED=true
GUARDRAIL_REDACTION_ENABLED=true
GUARDRAIL_UNSAFE_CONTENT_ENABLED=true

# Observability (task_003 scaffolding; task_013 wires exporters/metrics)
OTEL_SERVICE_NAME=ecrke
# Leave empty for the stubbed in-memory tracer (no exporter). Set to an OTLP
# HTTP endpoint (e.g. http://localhost:4318) to start exporting spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
